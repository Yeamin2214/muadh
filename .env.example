# Copy to .env.local and fill in. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# Models (change here if a provider renames a model)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
GROQ_MODEL_ALT=qwen/qwen3-32b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Shared password for the demo accounts (create them with: node scripts/seed-demo.mjs)
DEMO_PASSWORD=

# Safety thresholds (tuned on the test set)
AGREEMENT_MIN=0.55
MIN_SIMILARITY=0.40
STRONG_MATCH=0.60
MAX_UNSUPPORTED=0.25

# Used only by the data loading script
QURANENC_EN=english_hilali_khan
QURANENC_BN=bengali_zakaria
