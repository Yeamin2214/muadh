# Copy to .env.local and fill in. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# Email (Brevo): mentor approval emails
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Mu'adh

# AI models (run: node scripts/check-models.mjs to test them)
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_ALT=gemini-3.1-flash-lite
GEMINI_MODEL_LITE=gemini-flash-lite-latest
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
OPENROUTER_MODEL=

# Shared password for the demo accounts (create them with: node scripts/seed-demo.mjs)
DEMO_PASSWORD=

# Safety thresholds (tuned on the test set)
AGREEMENT_MIN=0.55
MIN_SIMILARITY=0.40
STRONG_MATCH=0.60
MAX_UNSUPPORTED=0.25

# Used only by the data loading script
QURANENC_EN=english_hilali_khan
QURANENC_BN=bengali_zakaria
